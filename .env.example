# ─────────────────────────────────────────────────────────────────────────────
# Copa do Mundo 2026 — Variáveis de Ambiente Exemplo
# Copie este arquivo para .env e preencha os valores correspondentes:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_USER=copa2026
POSTGRES_PASSWORD=postgres
POSTGRES_DB=copa2026
POSTGRES_PORT=5432

# ─── Backend ──────────────────────────────────────────────────────────────────
BACKEND_PORT=3001

# JWT — OBRIGATÓRIO: use uma string longa e aleatória em produção
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=sua_chave_secreta_jwt_longa_e_aleatoria
JWT_EXPIRES_IN=7d

# Rate limiting global da API (milissegundos e número máximo de requests por janela)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Seed no container de migração:
# - produção com banco já em uso: false
# - ambiente novo (primeira carga de dados): true
RUN_SEED=false

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Desenvolvimento: use Mailtrap (https://mailtrap.io) ou Mailpit
# Produção: use SendGrid, Amazon SES, Resend, etc.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=seu_email@gmail.com
MAIL_PASS=sua_senha_de_aplicativo_smtp
MAIL_FROM=seu_email@gmail.com

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# URL da API usada pelo BROWSER do usuário para chamar o backend
# Em produção, use o domínio público do backend (ex: https://api.copa2026.com/api)
# Em desenvolvimento local com Docker: http://localhost:3001/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ─── Football-Data.org (Sincronização de Placares) ────────────────────────────
# Obtenha sua chave gratuita em https://www.football-data.org/
API_FOOTBALL_KEY=sua_chave_aqui
API_FOOTBALL_URL=https://api.football-data.org/v4
API_FOOTBALL_SEASON=2026
API_FOOTBALL_POLLING_MINUTES=5
