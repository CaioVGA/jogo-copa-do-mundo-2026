# ─────────────────────────────────────────────────────────────────────────────
# Copa do Mundo 2026 — Variáveis de Ambiente Docker
# Copie este arquivo para .env e preencha os valores antes de rodar:
#   cp .env.docker .env
# ─────────────────────────────────────────────────────────────────────────────

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_USER=copa2026
POSTGRES_PASSWORD=postgres
POSTGRES_DB=copa2026
POSTGRES_PORT=5432

# ─── Backend ──────────────────────────────────────────────────────────────────
BACKEND_PORT=3001

# JWT — OBRIGATÓRIO: use uma string longa e aleatória em produção
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=mude_este_secret_jwt_em_producao_use_uma_string_longa_e_aleatoria
JWT_EXPIRES_IN=7d
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Produção com banco já existente: false
# Ambiente novo (primeira carga): troque para true manualmente
RUN_SEED=false

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Desenvolvimento: use Mailtrap (https://mailtrap.io) ou Mailpit
# Produção: use SendGrid, Amazon SES, Resend, etc.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=seu_email@gmail.com
MAIL_PASS=sua_senha_de_aplicativo_smtp
MAIL_FROM=seu_email@gmail.com

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# URL da API usada pelo BROWSER do usuário para chamar o backend
# Em produção, use o domínio público do backend (ex: https://api.copa2026.com/api)
# Em desenvolvimento local com Docker: http://localhost:3001/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api
